# Local mode binds to loopback only, gives free local tool trials, and NEVER simulates payment.
APP_MODE=local
PORT=8787
DATA_DIR=./data
# production requires HTTPS reverse proxy + persistent disk and all variables below.
WECHAT_APP_ID=wx5492d17de04b205d
WECHAT_APP_SECRET=
XPAY_OFFER_ID=
XPAY_APP_KEY=
XPAY_PRODUCT_SINGLE=
XPAY_PRODUCT_MONTH=
# Integer fen, must match published WeChat product prices. No code defaults.
LIGHT_PRICE_SINGLE_FEN=100
LIGHT_PRICE_MONTH_FEN=990
# Set true only after iOS IAP is actually enabled in the WeChat console.
XPAY_IOS_ENABLED=false
# Safe mode message push: Token + 43-character EncodingAESKey, and mini-program original ID.
WECHAT_PUSH_TOKEN=
WECHAT_PUSH_AES_KEY=
WECHAT_ORIGINAL_ID=
# 32 random bytes encoded as hex; encrypts session keys in the database.
SESSION_ENCRYPTION_KEY=
# Optional in local mode. Required to enable real ID photo background replacement.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=ap-guangzhou
