.tabs{position:fixed;bottom:0;left:0;right:0;z-index:20;display:flex;justify-content:space-around;padding:22rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));background:#F7F7F2;border-top:1rpx solid #E0E4D7}.tab{display:flex;align-items:center;justify-content:center;min-width:180rpx;height:65rpx;margin:0;padding:0;border:0;background:transparent;font-size:25rpx;color:#7B8072;line-height:65rpx}.tab::after{border:0}.active{color:#20221F;font-weight:600}.dot{width:12rpx;height:12rpx;border-radius:50%;background:#20221F;margin-right:15rpx}
