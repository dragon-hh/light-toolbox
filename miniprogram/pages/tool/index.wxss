.tool-intro{display:flex;align-items:center;justify-content:space-between;margin:20rpx 0 24rpx}.tool-intro .title{max-width:520rpx;font-size:49rpx}.tool-intro image{width:82rpx;height:82rpx;transform:rotate(9deg)}button.drop-zone{margin-top:0;width:100%;min-height:310rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;background:#EFF2E7;border:2rpx dashed #B9C4A7;border-radius:26rpx;padding:34rpx;position:relative}.upload-icon{width:84rpx;height:84rpx;background:#E3FA74;border-radius:24rpx;display:flex;align-items:center;justify-content:center;margin-bottom:22rpx}.upload-icon image{width:42rpx;height:42rpx}.drop-zone .muted{margin-top:12rpx}.source-image{width:100%;height:360rpx}.replace{font-size:23rpx;margin-top:18rpx;color:#69765D}.small-note{font-size:22rpx;margin-top:20rpx;line-height:1.7}.options{display:flex;gap:14rpx;margin-top:20rpx}.option{flex:1;border:2rpx solid #E5E9DF;border-radius:18rpx;padding:17rpx 8rpx;text-align:center;font-size:26rpx;background:#FAFBF7}.selected{border-color:#7F9447!important;background:#F1F6DE!important}.dimension{font-size:18rpx}.color-option{flex:1;display:flex;align-items:center;justify-content:center;border:2rpx solid #E5E9DF;border-radius:18rpx;padding:18rpx 0;font-size:25rpx;gap:13rpx}.color-dot{width:32rpx;height:32rpx;border-radius:50%;border:1rpx solid #C8D0BE}.quality{font-size:48rpx}.quality text{font-size:24rpx}.names{width:100%;height:360rpx;margin:28rpx 0;padding:22rpx;background:#F6F7F1;border-radius:18rpx;font-size:29rpx;line-height:1.8}.count-row{padding:18rpx 0}.count-input{background:#F2F4E9;width:120rpx;padding:18rpx;text-align:center;border-radius:15rpx;font-family:'Courier New',monospace}.consent{display:flex;align-items:center;justify-content:center;font-size:23rpx;margin:36rpx 0 24rpx;color:#7B8270;flex-wrap:wrap}.consent checkbox{transform:scale(.7)}.consent .link{font-size:23rpx}.file-row{display:flex;align-items:center;border-bottom:1rpx solid #DEE4D4;padding:20rpx 0;gap:14rpx}.file-index{font-size:24rpx;color:#879575;width:30rpx}.file-info{flex:1;min-width:0}.file-name{white-space:nowrap;text-overflow:ellipsis;overflow:hidden;font-size:25rpx}.file-row button{width:58rpx;height:60rpx;line-height:60rpx;text-align:center;border-radius:12rpx;background:#E9EDDF;font-size:29rpx}.file-row .muted{font-size:20rpx}.result{border:2rpx solid #B2C888}.result-image{width:100%;height:450rpx;background:#F2F4EA;border-radius:18rpx;margin-top:24rpx}.result-stat{font-size:34rpx;font-weight:600;margin-top:26rpx}.result-stat text{font-size:25rpx;font-weight:400;color:#68803C}.winner{font-size:37rpx;padding:20rpx 0;border-bottom:1rpx solid #E8EDDF}.winner text{color:#8B9A69;margin-right:30rpx;font-size:26rpx}
.usage-bar{display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:#E9EEDD;border-radius:16rpx;padding:18rpx 22rpx;margin-top:20rpx;font-size:24rpx;color:#485F35}.usage-bar text{flex:1}.usage-bar .link{flex-shrink:0}.result-records{display:block;text-align:center;margin-top:28rpx}.file-row button{min-width:64rpx;min-height:70rpx}.result-stat{font-size:30rpx}.result-stat text{display:block;margin-top:8rpx}
.consent-scope{font-size:22rpx;color:#6B765B;line-height:1.7;margin:-8rpx 0 0}button.tool-submit{margin-top:28rpx}

.usage-bar{margin:0 0 24rpx}.file-summary{margin-top:24rpx}.help-toggle{margin-left:14rpx}.tool-page{padding-top:24rpx}
