page { background:#183F35; color:#FFF5DB; font-family:'PingFang SC','Microsoft YaHei',sans-serif; }
.wheel-page { padding:28rpx 34rpx calc(60rpx + env(safe-area-inset-bottom)); overflow:hidden; }
.masthead,.page-heading,.steps,.wheel-caption { position:relative; }
.masthead { display:flex; justify-content:space-between; align-items:center; border-bottom:1rpx solid #557064; padding-bottom:20rpx; }
.kicker,.edition,.entry-number,.hub-small,.result-kicker { font-family:'DIN Alternate','Courier New',monospace; letter-spacing:3rpx; }
.kicker { font-size:19rpx; color:#D0D8BD; }.edition { font-size:24rpx; color:#F6C94C; }
.page-heading { margin:30rpx 0 26rpx; }.headline { font-size:46rpx; font-weight:700; letter-spacing:-1.5rpx; }.subtitle { font-size:23rpx; margin-top:10rpx; color:#C1D0BB; }
.steps { display:flex; align-items:center; gap:22rpx; margin-bottom:34rpx; font-size:23rpx; }.step { color:#90AD99; }.step text { font-family:'DIN Alternate',monospace; margin-right:6rpx; }.step.active { color:#F6C94C; }.step-line { height:1rpx; width:68rpx; background:#597165; }
.wheel-error { padding:24rpx; background:#FFF0E7; color:#944D2B; margin:24rpx 0; border-radius:16rpx; font-size:24rpx; }.wheel-error button { text-decoration:underline; margin-top:16rpx; }
.editor-title { background:#254B40; padding:22rpx 26rpx; border-radius:18rpx; border:1rpx solid #547363; }.field-label { font-size:27rpx; font-weight:600; }.editor-title .field-label { color:#BFCFBB; font-size:22rpx; }.editor-title input { font-size:34rpx; font-weight:600; height:65rpx; color:#FFF5DB; }
.editor-heading { margin:32rpx 0 18rpx; display:flex; align-items:center; justify-content:space-between; }.option-count { color:#F6C94C; font-size:22rpx; margin-left:15rpx; }.hint { font-size:21rpx; color:#B9CAB5; }
.entry { background:#FFF5DB; color:#183F35; border-radius:20rpx; margin-bottom:18rpx; padding:22rpx; }.entry-main { display:flex; gap:22rpx; }button.image-picker { flex-shrink:0; width:124rpx; height:124rpx; border-radius:16rpx; overflow:hidden; position:relative; background:#E9E4D5; }.image-picker image { width:100%; height:100%; }.image-edit { position:absolute; bottom:0; left:0; right:0; background:rgba(24,63,53,.82); text-align:center; color:#FFF5DB; font-size:19rpx; height:32rpx; line-height:32rpx; }.image-empty { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; font-size:19rpx; }.image-empty image { width:36rpx; height:36rpx; }
.entry-text { flex:1; min-width:0; }.entry-number { font-size:17rpx; color:#70806B; }.entry-text textarea { width:100%; height:84rpx; font-size:28rpx; line-height:40rpx; padding-top:4rpx; }.entry-footer { display:flex; justify-content:space-between; align-items:center; margin-top:16rpx; border-top:1rpx solid #DFDDC8; padding-top:12rpx; }.probability { display:flex; align-items:center; gap:10rpx; font-size:24rpx; font-family:'DIN Alternate','PingFang SC',sans-serif; }.color-dot { width:18rpx; height:18rpx; border:1rpx solid #9A9D77; border-radius:50%; }.weight-field { display:flex; align-items:center; gap:8rpx; font-size:20rpx; }.weight-field input { width:68rpx; height:46rpx; text-align:center; border:1rpx solid #C9CDB5; background:#FFFFFF; border-radius:8rpx; font-size:24rpx; }.entry-actions { display:flex; align-items:center; gap:12rpx; }.entry-actions button { width:46rpx; height:46rpx; text-align:center; font-size:28rpx; }.entry-actions button.remove { width:62rpx; font-size:21rpx; color:#946246; }
button.add-entry { width:100%; padding:22rpx; text-align:center; border:2rpx dashed #718A70; border-radius:18rpx; color:#E4E3BA; font-size:25rpx; }.weight-settings { margin-top:28rpx; padding:26rpx; background:#E1E5CE; color:#183F35; border-radius:18rpx; }.weight-settings .hint { color:#677963; }.weight-explanation { margin-top:20rpx; padding-top:16rpx; border-top:1rpx solid #BBC7AE; font-size:22rpx; line-height:1.8; }.weight-settings switch { transform:scale(.85); transform-origin:right center; }
.local-note { display:flex; align-items:flex-start; gap:12rpx; margin:24rpx 8rpx; font-size:21rpx; color:#C1D0BB; }.local-note image { flex-shrink:0; width:30rpx; height:30rpx; background:#D7DEC3; border-radius:5rpx; }
button.save-wheel,button.spin-button { width:100%; padding:27rpx 26rpx; background:#F6C94C; color:#183F35; font-size:29rpx; font-weight:700; border-radius:18rpx; box-shadow:0 8rpx 0 #B48925; text-align:center; }.save-wheel text { margin-left:30rpx; }.save-wheel[disabled],.spin-button[disabled] { background:#D5C07E; color:#183F35; }
.wheel-caption { display:flex; align-items:center; justify-content:space-between; margin-top:8rpx; gap:16rpx; }.wheel-title { font-size:29rpx; max-width:470rpx; font-weight:600; overflow-wrap:break-word; }.edit-wheel { color:#DFD7AC; font-size:22rpx; flex-shrink:0; text-decoration:underline; }
.wheel-stage { position:relative; height:685rpx; margin:4rpx -8rpx 0; }.machine { width:622rpx; height:622rpx; position:absolute; top:30rpx; left:50%; margin-left:-311rpx; border-radius:50%; background:#285245; border:3rpx solid #A3B697; box-shadow:0 14rpx 0 #0C2D25,0 24rpx 30rpx rgba(0,0,0,.2); z-index:2; }.rotor { position:absolute; top:32rpx; left:32rpx; width:552rpx; height:552rpx; border-radius:50%; overflow:hidden; background:#F5E1A9; transition-property:transform; transition-timing-function:cubic-bezier(.12,.72,.13,1); }.rotor image { width:100%; height:100%; }.bulb { position:absolute; left:50%; top:50%; width:0; height:0; }.bulb-dot { position:absolute; width:12rpx; height:12rpx; top:-299rpx; left:-6rpx; border-radius:50%; background:#FFEAB0; box-shadow:0 0 9rpx #F6C94C; }.spinning .bulb:nth-child(2n) .bulb-dot { animation:twinkle .4s infinite alternate; }.spinning .bulb:nth-child(2n + 1) .bulb-dot { animation:twinkle .4s .4s infinite alternate; }
.pointer { position:absolute; top:-17rpx; left:50%; width:0; height:0; margin-left:-24rpx; border-left:24rpx solid transparent; border-right:24rpx solid transparent; border-top:64rpx solid #EE704B; filter:drop-shadow(0 4rpx 0 #713F2E); z-index:4; }button.hub { position:absolute; top:50%; left:50%; width:144rpx; height:144rpx; margin:-72rpx 0 0 -72rpx !important; border-radius:50%; background:#183F35; border:7rpx solid #FFF5DB; box-shadow:0 6rpx 14rpx #274E3B; color:#F6C94C; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center; z-index:3; }.hub[disabled] { opacity:1; }.hub-small { font-size:16rpx; letter-spacing:1rpx; line-height:23rpx; }.hub-big { font-size:48rpx; line-height:54rpx; font-weight:800; font-family:'DIN Alternate',monospace; }
.orbit { position:absolute; border:1rpx solid #55735C; border-radius:50%; width:690rpx; height:545rpx; left:50%; margin-left:-345rpx; top:70rpx; transform:rotate(-24deg); }.orbit-two { transform:rotate(24deg); border-color:#3B6450; }.orbit-label { position:absolute; right:4rpx; top:15rpx; font-size:14rpx; letter-spacing:3rpx; color:#8DA88A; transform:rotate(8deg); }.wheel-base { position:absolute; bottom:13rpx; width:230rpx; height:55rpx; left:50%; margin-left:-115rpx; background:#294E3D; border:1rpx solid #6D835F; border-radius:50%; }
.spin-status { text-align:center; font-size:23rpx; color:#CCDAC2; margin:0 0 22rpx; }.draw-consent { display:flex; align-items:center; justify-content:center; gap:8rpx; font-size:22rpx; color:#D4DBC2; margin:22rpx 0 24rpx; }.draw-consent label { display:flex; align-items:center; }.draw-consent checkbox { transform:scale(.72); }.draw-consent button { color:#F6C94C; font-size:22rpx; text-decoration:underline; }.spin-button text { font-size:34rpx; margin-left:20rpx; }.price-note { text-align:center; font-size:20rpx; color:#B6C6AA; margin-top:24rpx; }
.prize-result { position:relative; background:#FFF5DB; color:#183F35; padding:28rpx; border-radius:22rpx; border:3rpx solid #F6C94C; overflow:hidden; animation:prize-in .4s ease-out; }.result-kicker { font-size:18rpx; color:#69734B; }.prize-body { display:flex; align-items:center; gap:24rpx; margin-top:20rpx; }.prize-image { width:125rpx; height:125rpx; flex-shrink:0; border-radius:16rpx; }.prize-copy { flex:1; min-width:0; }.prize-label { display:block; font-size:35rpx; font-weight:700; line-height:1.4; overflow-wrap:break-word; }.prize-title { display:block; font-size:21rpx; color:#708066; margin-top:10rpx; }.confetti { pointer-events:none; position:absolute; inset:0; }.confetti view { position:absolute; top:-15rpx; width:9rpx; height:20rpx; animation:confetti 1.6s ease-out both; }
.legend { margin-top:34rpx; border-top:1rpx solid #56735E; padding-top:24rpx; }.legend-header { display:flex; justify-content:space-between; margin-bottom:16rpx; font-size:25rpx; }.legend-header text:last-child { color:#BBCEB4; font-size:21rpx; }.legend-row { display:flex; align-items:center; gap:18rpx; padding:13rpx 0; }.legend-row image { width:58rpx; height:58rpx; border-radius:12rpx; flex-shrink:0; }.legend-label { flex:1; font-size:24rpx; overflow-wrap:break-word; }.legend-chance { color:#F6C94C; font-size:25rpx; font-family:'DIN Alternate',monospace; }.legend-note,.footnote { color:#B3C5AC; font-size:20rpx; margin-top:18rpx; }.footnote { text-align:center; margin-top:35rpx; }.render-canvas { position:fixed; left:-1000px; top:0; width:450px; height:450px; pointer-events:none; }
@keyframes twinkle { from { opacity:1; } to { opacity:.25; } }@keyframes prize-in { from { opacity:0; transform:translateY(16rpx); } to { opacity:1; transform:translateY(0); } }@keyframes confetti { from { transform:translateY(0) rotate(0); opacity:1; } to { transform:translateY(320rpx) rotate(210deg); opacity:0; } }
.wheel-page.editing{padding-bottom:calc(220rpx + env(safe-area-inset-bottom))}.editor-actions{position:fixed;bottom:0;left:0;right:0;z-index:10;display:flex;align-items:center;gap:24rpx;padding:22rpx 34rpx calc(26rpx + env(safe-area-inset-bottom));background:#183F35;border-top:1rpx solid #557064}.editor-actions .save-wheel{flex:1;font-size:27rpx;padding:24rpx 16rpx}.editor-actions .save-wheel text{margin-left:12rpx}.cancel-edit{color:#FFF5DB;font-size:25rpx;padding:20rpx 4rpx}.entry-text textarea{min-height:84rpx}.draw-consent{font-size:25rpx}.draw-consent checkbox{transform:scale(.85)}.entry-actions button{min-width:64rpx;min-height:64rpx}.entry-actions button.remove{min-width:74rpx}.hint,.local-note{font-size:23rpx}
.consent-scope{font-size:22rpx;color:#CCDAC2;line-height:1.7;margin:-8rpx 0 24rpx}.draw-consent{flex-wrap:wrap}

button.legend-toggle{width:100%;display:flex;justify-content:space-between;align-items:center;min-height:64rpx;font-size:25rpx}.legend-toggle text{color:#BBCEB4;font-size:23rpx}.prize-result{margin-bottom:26rpx}.result-kicker{letter-spacing:0;font-family:inherit;font-size:23rpx}.wheel-caption{margin-bottom:20rpx}.wheel-page{padding-top:24rpx}
