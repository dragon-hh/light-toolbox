.hero{position:relative;margin-bottom:34rpx}.hero-title{font-weight:700;font-size:68rpx;line-height:1.2;letter-spacing:-4rpx}.period{color:#99AA45}.hero-stamp{position:absolute;right:10rpx;top:5rpx;width:140rpx;height:140rpx;background:#E3FA74;border-radius:50%;transform:rotate(12deg);display:flex;align-items:center;justify-content:center}.hero-stamp image{width:70rpx;height:70rpx}.tool-grid{display:flex;flex-wrap:wrap;justify-content:space-between}button.tool-card{position:relative;width:calc(50% - 10rpx);border-radius:26rpx;padding:28rpx 25rpx;margin-bottom:20rpx;overflow:hidden;text-align:left}.green{background:#DFE9D8}.yellow{background:#EDF0CD}.orange{background:#F4E2D3}.stone{background:#E9EAE2}.arrow{position:absolute;right:24rpx;top:24rpx;width:25rpx;height:25rpx}.art{height:100rpx;display:flex;align-items:center;justify-content:center;margin-top:10rpx}.art image{width:82rpx;height:82rpx;transform:rotate(-9deg)}.yellow .art image{transform:rotate(10deg)}.orange .art image{transform:rotate(-6deg)}.tool-name{font-size:35rpx;font-weight:600;margin-top:18rpx}.tool-detail{font-size:23rpx;color:#65705C;margin-top:8rpx}button.member-banner{width:100%;margin-top:14rpx;background:#252C24;color:#F7F8EF;border-radius:24rpx;padding:30rpx;display:flex;align-items:center;justify-content:space-between}.member-kicker{font-size:29rpx;font-weight:600}.member-desc{color:#B9C0AF;font-size:23rpx;margin-top:8rpx}.member-price{font-family:'Courier New',monospace;font-weight:700;color:#E3FA74;font-size:47rpx;display:flex;align-items:center}.member-price text{font-size:26rpx}.member-price image{width:32rpx;height:32rpx;margin-left:16rpx;filter:invert(1)}
