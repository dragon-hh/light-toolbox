.record-icon{width:78rpx;height:78rpx;border-radius:21rpx;display:flex;align-items:center;justify-content:center;background:#EEF3DF;margin-right:20rpx}.record-icon image{width:42rpx;height:42rpx}.record-info{flex:1}.record-info .muted{font-size:19rpx}.status{font-size:20rpx;color:#7E8970}.succeeded{color:#5A762F}.failed{color:#AD673C}.record-bottom{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16rpx;border-top:1rpx solid #E7EDDD;padding-top:24rpx;margin-top:24rpx}.job-id{font-size:17rpx;color:#9AA38C}.record .section-title{font-size:29rpx}
.record-info .muted{font-size:23rpx}.record-info{min-width:0}.record .status{flex-shrink:0;margin-left:12rpx;font-size:22rpx}.record-expiry{font-size:24rpx;color:#627747;margin-top:22rpx}.record-bottom{gap:18rpx;padding-top:20rpx;margin-top:20rpx}.record-actions{display:flex;gap:20rpx;align-items:center}.record-bottom .diagnostic{font-size:22rpx;color:#727B68}.save-record{background:#E9EEDD;color:#38542C;border-radius:12rpx;padding:14rpx 20rpx;font-size:25rpx}.record-bottom .link{min-height:64rpx;line-height:64rpx}

.page{padding-top:8rpx}.record-details{margin-top:16rpx;padding-top:20rpx;border-top:1rpx solid #E7EDDD;font-size:23rpx;color:#68775A;overflow-wrap:anywhere}.record-details text{display:block}.record-details button{margin-top:12rpx}
