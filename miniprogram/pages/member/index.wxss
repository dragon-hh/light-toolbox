.intro{margin-top:12rpx}
.membership-card{margin-top:32rpx;padding:32rpx;border-radius:28rpx;background:#252E22;color:#F7F7F2}
.membership-label{font-size:27rpx;font-weight:600;letter-spacing:1rpx}
.membership-status{padding:3rpx 16rpx;border-radius:30rpx;background:#E3FA74;color:#34452A;font-size:23rpx}
.membership-title{font-size:38rpx;font-weight:600;line-height:1.4;margin-top:28rpx}
.membership-tools{font-size:23rpx;color:#D6DFC9;margin-top:12rpx}
.membership-expiry{font-size:24rpx;margin-top:30rpx;padding-top:24rpx;border-top:1rpx solid #4A5742}
.membership-note{font-size:23rpx;color:#C4CEB8;margin-top:5rpx}
button.use-tools{display:flex;align-items:center;justify-content:center;gap:18rpx;margin-top:24rpx;background:#E3FA74;color:#252E22}
.use-tools image{width:32rpx;height:32rpx}
.resume-note{text-align:center;margin-top:10rpx}
.saved-credits{padding:28rpx 2rpx;gap:18rpx}
.credits-title{font-size:26rpx;font-weight:500}
.saved-credits .muted{font-size:22rpx;margin-top:5rpx}
.credit{font-size:23rpx;color:#6B765B;white-space:nowrap}
.credit text{font-size:42rpx;color:#20221F}
.profile{background:#E9EEDD}
button.account-entry{width:100%;display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:26rpx 0;text-align:left;border-bottom:1rpx solid #E0E5D8}
.account-entry .section-title{font-size:28rpx;font-weight:500}
.account-entry .muted{font-size:23rpx;margin-top:3rpx}
.entry-arrow{font-size:38rpx;line-height:1;color:#6B765B}
button.renewal-entry{border-top:1rpx solid #E0E5D8}
.account-menu{margin-top:14rpx}
.account-menu .account-entry:last-child{border-bottom:0}
.renewal-purchase{margin-top:22rpx;padding:28rpx;border:1rpx solid #D8E2CB;border-radius:26rpx;background:#FFF}
.plans{margin:28rpx 0}
button.plan{width:100%;border:2rpx solid #E0E5D5;border-radius:26rpx;padding:30rpx;margin-bottom:22rpx;background:#FFF}
button.plan.chosen{border:3rpx solid #7B9250;background:#F2F6E7;padding:29rpx}
.radio{width:32rpx;height:32rpx;border:2rpx solid #BDC7AC;border-radius:50%}
.chosen .radio{border:10rpx solid #526C35;background:#FFF}
.price{font-family:'Courier New',monospace;font-size:84rpx;font-weight:700;margin:14rpx 0 5rpx;letter-spacing:-4rpx}
.price text{font-size:28rpx;font-weight:400;letter-spacing:0}
.price text:last-child{font-family:'PingFang SC','Microsoft YaHei',sans-serif;font-size:24rpx;color:#72805D}
.monthly-line{border-top:1rpx solid #D5E0B0;margin-top:27rpx;padding-top:22rpx;color:#66744F;font-size:22rpx}
.renewal-quote .muted{font-size:24rpx}
.benefits{display:flex;justify-content:space-between;font-size:22rpx;color:#637150;gap:8rpx}
.benefits view{display:flex;align-items:center}
.benefits image{width:27rpx;height:27rpx;margin-right:5rpx}
.terms{font-size:24rpx;color:#657058;margin:30rpx 0;line-height:1.8}
.terms checkbox{transform:scale(.8)}
.terms label{display:flex;align-items:center;min-height:64rpx}
.terms checkbox-group{margin-bottom:18rpx;color:#455A32;font-size:25rpx}
.order-panel{padding:24rpx;background:#FFF;border:1rpx solid #E0E5D8;border-radius:20rpx;margin:12rpx 0}
.order{padding:24rpx 0;border-bottom:1rpx solid #E9EDE1}
.order:last-child{border-bottom:0;padding-bottom:0}
.order .muted{font-size:22rpx;margin-top:10rpx}
.order-actions{margin-top:12rpx;gap:18rpx}
.order-panel>.muted{font-size:22rpx}
.order-panel .empty{font-size:25rpx}

.member-page{padding-top:12rpx}.membership-card{margin-top:12rpx}button.renewal-entry{margin-top:24rpx}.saved-credits + .renewal-entry{margin-top:0}.terms checkbox-group{margin:18rpx 0 0}.order-details{margin-top:18rpx;padding-top:18rpx;border-top:1rpx dashed #D9E2CB;font-size:23rpx;color:#657058;overflow-wrap:anywhere}.order-details text{display:block}.order-details button{margin:10rpx 0}
