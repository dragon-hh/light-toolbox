page { background:#F7F7F2; color:#20221F; font-family:-apple-system,BlinkMacSystemFont,'PingFang SC','Microsoft YaHei',sans-serif; font-size:28rpx; line-height:1.6; }
view,button,input,textarea { box-sizing:border-box; }
button { margin:0; padding:0; border:0; border-radius:0; background:transparent; color:inherit; font:inherit; line-height:inherit; text-align:left; }
/* style:v2 sets a fixed width and automatic margins on regular buttons. Reset that selector before applying component sizing. */
button:not([size="mini"]) { width:auto; margin:0; }
button.space-top:not([size="mini"]) { margin-top:28rpx; }
button::after { border:0; }
button[disabled] { opacity:.48; }
image { display:block; }
.page { padding:40rpx 36rpx calc(180rpx + env(safe-area-inset-bottom)); }
.row { display:flex; align-items:center; justify-content:space-between; }
.mono,.eyebrow { font-family:'Courier New',monospace; }
.eyebrow { font-size:18rpx; letter-spacing:2rpx; color:#7B846F; }
.title { font-size:48rpx; font-weight:650; letter-spacing:-2rpx; line-height:1.35; }
.section-title { font-size:30rpx; font-weight:600; }
.muted { color:#7B8270; font-size:23rpx; }
.space-top { margin-top:28rpx; }
.pill { display:flex; align-items:center; border:1rpx solid #D9DFCE; border-radius:40rpx; padding:7rpx 16rpx; color:#768068; font-size:20rpx; white-space:nowrap; }
.panel { background:#FFFFFF; border:1rpx solid #E3E8DC; border-radius:28rpx; padding:32rpx; margin-top:32rpx; }
button.primary,button.secondary { display:block; width:100%; text-align:center; border-radius:20rpx; padding:26rpx 20rpx; font-size:29rpx; font-weight:600; }
.primary { background:#252E22; color:#F8FAF2; }
.primary[disabled] { background:#252E22; color:#F8FAF2; }
.secondary { background:#FFFFFF; color:#3D4E30; border:1rpx solid #D9E2CB; font-size:26rpx; font-weight:400; }
.link { display:inline-block; color:#658148; font-size:23rpx; text-decoration:underline; }
.notice { margin-top:26rpx; padding:20rpx 24rpx; background:#EDF1E5; border-radius:18rpx; color:#6F7C5F; font-size:22rpx; line-height:1.8; }
.error { padding:24rpx; margin:28rpx 0; border-radius:18rpx; background:#FFF0E7; color:#944D2B; font-size:24rpx; overflow-wrap:break-word; }
.badge { background:#E3FA74; border-radius:10rpx; padding:5rpx 13rpx; font-size:20rpx; color:#405226; white-space:nowrap; }
.empty { padding:70rpx 24rpx; text-align:center; }
.empty .icon { width:105rpx; height:105rpx; margin:0 auto 30rpx; opacity:.45; }
button.bottom-note,.bottom-note { display:block; width:100%; color:#929A87; text-align:center; font-size:20rpx; line-height:1.8; margin-top:26rpx; }
.muted{font-size:25rpx}.link{min-height:48rpx;line-height:1.8}.notice{font-size:24rpx}.consent label{min-height:64rpx;display:flex;align-items:center}.consent checkbox{transform:scale(.85)}
button.primary[disabled]:not([type]){background:#DEE4D4;color:#4F5C43;opacity:1}
