.error-notice{padding:24rpx;margin:24rpx 0;border-radius:18rpx;background:#FFF0E7;color:#944D2B;font-size:25rpx;line-height:1.7;overflow-wrap:break-word}.actions{display:flex;flex-wrap:wrap;gap:12rpx 28rpx}.actions button:not([size="mini"]){width:auto;margin:10rpx 0 0;padding:8rpx 0;min-height:56rpx;background:transparent;color:#944D2B;font:inherit;text-decoration:underline;text-align:left;line-height:1.6}.actions button::after{border:0}.actions button[disabled]{opacity:.5}.actions .details-toggle{font-size:23rpx}.diagnostic{display:block;margin-top:12rpx;padding-top:16rpx;border-top:1rpx solid #EACDBB;white-space:pre-wrap;font-size:23rpx}
