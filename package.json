{
  "name": "light-toolbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "build:cloud": "node scripts/build-cloud.js",
    "reconcile": "node --env-file=.env server/reconcile.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fast-xml-parser": "^5.3.0",
    "helmet": "^8.1.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.35.5",
    "tencentcloud-sdk-nodejs-bda": "^4.1.138"
  },
  "overrides": {
    "tencentcloud-sdk-nodejs-common": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "lucide-static": "^0.468.0"
  }
}
